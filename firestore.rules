rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only the two registered Sweet Sip devices may access shop data.
    // Add a new Firebase Auth UID here when the shop replaces a phone.
    function isShopDevice() {
      return request.auth != null && request.auth.uid in [
        'vvWHfmpOyOa4MhxCgckTamhhWS12',
        'j5zB1DdL4fQwBCNzTLF7Gr0Xv8A2'
      ];
    }

    match /transactions/{transactionId} {
      allow read: if isShopDevice();
      allow create: if isShopDevice()
        && request.resource.data.keys().hasOnly([
          'createdAt', 'exchangeRate', 'workerName', 'orderNote', 'items'
        ])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.exchangeRate is number
        && request.resource.data.exchangeRate > 0
        && request.resource.data.workerName is string
        && request.resource.data.orderNote is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50;
      allow update, delete: if false;
    }

    match /products/{productId} {
      allow read, write: if isShopDevice();
    }

    // Gemini now runs through Firebase AI Logic + App Check. The app no longer
    // creates AI request documents in Firestore.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
